<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily Cricsheet refresh. __REPO__ is substituted at install time, so this
     template works on any machine with a clone. Install:

       sed "s|__REPO__|$PWD|g" scripts/io.stryk.refresh.plist \
         > ~/Library/LaunchAgents/io.stryk.refresh.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.stryk.refresh.plist

     Uninstall: launchctl bootout gui/$(id -u)/io.stryk.refresh
     Run now:   launchctl kickstart -p gui/$(id -u)/io.stryk.refresh -->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.stryk.refresh</string>

  <key>ProgramArguments</key>
  <array><string>__REPO__/scripts/refresh.sh</string></array>

  <key>WorkingDirectory</key><string>__REPO__</string>

  <!-- Evening, when the laptop is open. A laptop asleep at this hour does not
       miss the run: launchd fires it once on wake. Powered off, it runs at
       next login. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>30</integer></dict>

  <key>StandardOutPath</key><string>__REPO__/data/refresh.log</string>
  <key>StandardErrorPath</key><string>__REPO__/data/refresh.log</string>
</dict>
</plist>
